# Copy to .env for local overrides. In production set these on the host.
APP_ENV=development

# Required in production
JWT_SECRET=
NEWSROOM_API_KEY=

# Database (defaults to SQLite in apps/api/data). Use Postgres in production.
NEWS_DATABASE_URL=

# Comma-separated JSON list of origins allowed to call the API with cookies, e.g.
# NEWS_CORS_ORIGINS=["https://news.example.com","https://newsroom.example.com"]
NEWS_CORS_ORIGINS=[]
# Use "none" when reader and API are on different sites.
NEWS_COOKIE_SAMESITE=lax

# Optional: Supabase Auth. Without it, local accounts are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Postgres connection string (Neon etc.). Takes precedence over NEWS_DATABASE_URL.
DATABASE_URL=

# Neon Auth (reader sign-in alongside the local login). Base URL of your Neon Auth endpoint,
# e.g. https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth . Empty = off.
NEON_AUTH_URL=

# Optional AI. Add any one key and AI assistance turns on in the Newsroom.
# Gemini (free tier) is preferred when its key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Any other OpenAI-compatible endpoint
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Static host deploy hook: called (debounced) after a publish so the prerendered Reader rebuilds.
NEWS_DEPLOY_HOOK_URL=

# Public addresses, used for links in emails.
READER_URL=http://localhost:3000
NEWSROOM_URL=http://localhost:5174/newsroom

# Email (invites, password resets) through Resend. Without a key, links are written to the log.
RESEND_API_KEY=
EMAIL_FROM=News APP <newsroom@your-domain.example>

# First admin, created on start when the newsroom has no admin. Change the password after signing in.
NEWSROOM_ADMIN_EMAIL=
NEWSROOM_ADMIN_PASSWORD=
NEWSROOM_ADMIN_NAME=Managing editor

# Uploaded photos, video and audio. Use a persistent volume in production (Railway: mount at /srv/media).
NEWS_MEDIA_DIR=
