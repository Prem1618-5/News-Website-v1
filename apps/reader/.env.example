# Public URL of the site. Used for canonical links, sitemaps, feeds and structured data.
# Set this before every production build: https://your-domain.example (no trailing slash).
VITE_SITE_URL=http://localhost:4173

# Platform API. Leave empty in development (Vite proxies /api to FastAPI on :8000).
# In production use the API origin, e.g. https://api.your-domain.example
# (same registrable domain as the site keeps the login cookie first-party).
VITE_API_URL=

# Shown on the Contact page and in structured data. Optional.
VITE_CONTACT_EMAIL=

# Build-time data source for the prerender step: a running API's snapshot endpoint,
# e.g. https://api.your-domain.example/api/snapshot.
# When empty, the build reads apps/api/content directly (offline build).
SNAPSHOT_URL=

# robots.txt policy for AI model-training crawlers (GPTBot, ClaudeBot, Google-Extended, CCBot...): allow | block.
# Retrieval and answer-engine crawlers (OAI-SearchBot, PerplexityBot, ChatGPT-User, Claude-SearchBot...) are always allowed.
AI_TRAINING=allow
